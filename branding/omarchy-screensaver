#!/bin/bash

# Stylish monochrome Omarchy screensaver (43pr silver palette).
# Overrides the packaged runner via ~/.config/omarchy/bin + warexpor.idle.
# Keeps stock Omarchy branding text; curates effects + grayscale colors.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)
branding="${OMARCHY_SCREENSAVER_TEXT:-$HOME/.config/omarchy/branding/screensaver.txt}"

wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# Atmospheric / polished effects only — no fireworks, bubbles, matrix rain, etc.
EFFECTS=(
  beams
  blackhole
  burn
  crumble
  decrypt
  errorcorrect
  expand
  highlight
  laseretch
  middleout
  overflow
  pour
  print
  rings
  scattered
  slice
  slide
  smoke
  spotlights
  swarm
  sweep
  synthgrid
  unstable
  vhstape
  waves
  wipe
)

# Soft silver settled looks.
PALETTES=(
  "ffffff cccccc 888888"
  "ffffff aaaaaa 555555"
  "eeeeee bbbbbb 777777"
  "ffffff dddddd 999999 444444"
  "f5f5f5 b0b0b0 6a6a6a"
)

pick() {
  local -n arr=$1
  echo "${arr[RANDOM % ${#arr[@]}]}"
}

gradient_args_for() {
  local effect=$1
  local palette=$2
  # shellcheck disable=SC2206
  local stops=($palette)
  local bright="${stops[0]}"
  local mid="${stops[1]:-aaaaaa}"
  local dim="${stops[2]:-555555}"
  local deep="${stops[3]:-$dim}"

  local args=(--final-gradient-stops ${stops[@]} --final-gradient-steps 16)

  case "$effect" in
  beams)
    args+=(--beam-gradient-stops "$bright" "$mid" "$dim")
    ;;
  blackhole)
    args+=(--blackhole-color "$bright" --star-colors "$bright" "$mid" "$dim" "$deep")
    ;;
  burn)
    args+=(--starting-color "$dim" --burn-colors "$bright" "$mid" "$dim" "$deep" "111111")
    ;;
  decrypt)
    args+=(--ciphertext-colors "$dim" "$mid" "$bright")
    ;;
  errorcorrect)
    args+=(--error-color "$dim" --correct-color "$mid")
    ;;
  laseretch)
    args+=(
      --laser-gradient-stops "$bright" "$mid"
      --cool-gradient-stops "$mid" "$dim"
      --spark-gradient-stops "$bright" "$mid" "$dim" "111111"
    )
    ;;
  middleout | pour | smoke)
    args+=(--starting-color "$bright")
    [[ "$effect" == smoke ]] && args+=(--smoke-gradient-stops "$deep" "$bright")
    ;;
  rings)
    args+=(--ring-colors "$bright" "$mid" "$dim")
    ;;
  swarm)
    args+=(--base-color "$mid" --flash-color "$bright")
    ;;
  synthgrid)
    args=(
      --grid-gradient-stops "$deep" "$mid"
      --text-gradient-stops ${stops[@]}
    )
    ;;
  overflow)
    args+=(--overflow-gradient-stops "$dim" "$bright")
    ;;
  unstable)
    args+=(--unstable-color "$mid")
    ;;
  vhstape)
    args+=(
      --glitch-line-colors "$bright" "$mid" "$dim" "$mid" "$bright"
      --glitch-wave-colors "$bright" "$mid" "$dim" "$mid" "$bright"
      --noise-colors "1a1a1a" "333333" "555555" "888888" "bbbbbb" "$bright"
    )
    ;;
  waves)
    args+=(--wave-gradient-stops "$dim" "$mid" "$bright" "$mid" "$dim")
    ;;
  esac

  printf '%s\n' "${args[@]}"
}

while true; do
  effect=$(pick EFFECTS)
  palette=$(pick PALETTES)
  mapfile -t grad_args < <(gradient_args_for "$effect" "$palette")

  ttfx -i "$branding" \
    --frame-rate 120 \
    --canvas-width 0 \
    --canvas-height 0 \
    --reuse-canvas \
    --anchor-canvas c \
    --anchor-text c \
    --no-eol \
    --no-restore-cursor \
    "$effect" \
    "${grad_args[@]}" &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
