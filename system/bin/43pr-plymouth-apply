#!/usr/bin/env bash
# Apply 43PR colors to the Omarchy Plymouth boot screen, then retint the
# unfilled progress track to neutral gray. Stock Omarchy only recolors the
# filled bar (progress_bar.png); progress_box.png stays Tokyo-Night violet.
set -euo pipefail

THEME_SLUG="${1:-43pr}"
TRACK_HEX="${2:-#2a2a2a}"
TRACK_HEX="${TRACK_HEX#\#}"

if ! [[ $TRACK_HEX =~ ^[0-9a-fA-F]{6}$ ]]; then
  echo "Invalid track color: #$TRACK_HEX (expected RRGGBB)" >&2
  exit 1
fi

theme_dir=$(omarchy-theme-dir "$THEME_SLUG")
box=/usr/share/plymouth/themes/omarchy/progress_box.png

echo "Setting Plymouth from theme '$THEME_SLUG'..."
omarchy plymouth set by theme "$THEME_SLUG"

echo "Retinting progress track to #$TRACK_HEX..."
sudo magick "$box" -channel RGB +level-colors "#$TRACK_HEX","#$TRACK_HEX" "$box"
sudo chmod 0644 -- "$box"

echo "Rebuilding initramfs so the boot splash picks up the track..."
if omarchy-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

echo "Done. Plymouth unlock logo: $theme_dir/unlock.png"
echo "Reboot (or resume from disk encryption) to see the gray progress track."
