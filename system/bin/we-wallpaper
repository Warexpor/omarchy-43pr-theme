#!/usr/bin/env bash
# Control linux-wallpaperengine alongside Omarchy's static background plugin.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/we-wallpaper"
STATE_FILE="$STATE_DIR/current"
PID_FILE="$STATE_DIR/pid"
WORKSHOP="${WE_WORKSHOP:-$HOME/.local/share/Steam/steamapps/workshop/content/431960}"
ASSETS="${WE_ASSETS:-$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/assets}"
SCREEN="${WE_SCREEN:-}"
FPS="${WE_FPS:-30}"
ENGINE="${WE_ENGINE:-linux-wallpaperengine}"

mkdir -p "$STATE_DIR"

die() { echo "we-wallpaper: $*" >&2; exit 1; }

need_engine() {
  command -v "$ENGINE" >/dev/null 2>&1 || die "$ENGINE not installed (install linux-wallpaperengine-git)"
}

default_screen() {
  if [[ -n "$SCREEN" ]]; then
    printf '%s\n' "$SCREEN"
    return
  fi
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
mons = json.load(sys.stdin)
for m in mons:
    if m.get("focused"):
        print(m["name"]); break
else:
    print(mons[0]["name"] if mons else "")
' 2>/dev/null
  fi
}

wallpaper_title() {
  local dir="$1" title=""
  if [[ -f "$dir/project.json" ]]; then
    title=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("title",""))' "$dir/project.json" 2>/dev/null || true)
  fi
  printf '%s\n' "${title:-$(basename "$dir")}"
}

is_running() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  pgrep -f '[l]inux-wallpaperengine' >/dev/null 2>&1
}

disable_omarchy_bg() {
  omarchy plugin disable omarchy.background >/dev/null 2>&1 || true
}

enable_omarchy_bg() {
  omarchy plugin enable omarchy.background >/dev/null 2>&1 || true
  # Re-apply current static background if one is linked.
  if [[ -L "$HOME/.local/state/omarchy/current/background" ]]; then
    local bg
    bg=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null || true)
    [[ -n "${bg:-}" && -f "$bg" ]] && omarchy theme bg set "$bg" >/dev/null 2>&1 || true
  fi
}

stop_engine() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
  pkill -f '[l]inux-wallpaperengine' 2>/dev/null || true
}

cmd_off() {
  stop_engine
  enable_omarchy_bg
  echo "Wallpaper Engine stopped; Omarchy background restored."
}

cmd_on() {
  need_engine
  local id="${1:-}"
  if [[ -z "$id" ]]; then
    [[ -f "$STATE_FILE" ]] || die "no wallpaper id (pass one, or run: we-wallpaper select)"
    id=$(cat "$STATE_FILE")
  fi

  local path="$id"
  if [[ ! -d "$path" ]]; then
    path="$WORKSHOP/$id"
  fi
  [[ -d "$path" ]] || die "wallpaper not found: $id"

  local screen
  screen=$(default_screen)
  [[ -n "$screen" ]] || die "could not detect monitor (set WE_SCREEN)"

  [[ -d "$ASSETS" ]] || die "WE assets missing at $ASSETS (install Wallpaper Engine in Steam)"

  stop_engine
  disable_omarchy_bg

  # Flag order matters: --scaling/--bg attach to the prior --screen-root.
  nohup "$ENGINE" \
    --assets-dir "$ASSETS" \
    --fps "$FPS" \
    --silent \
    --layer background \
    --screen-root "$screen" \
    --scaling fill \
    --bg "$path" \
    >"$STATE_DIR/engine.log" 2>&1 &
  echo $! >"$PID_FILE"
  basename "$path" >"$STATE_FILE"

  echo "Running $(wallpaper_title "$path") on $screen (fps=$FPS, silent)."
  echo "Log: $STATE_DIR/engine.log"
}

cmd_select() {
  need_engine
  [[ -d "$WORKSHOP" ]] || die "workshop folder missing: $WORKSHOP"

  local list tmp choice id
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT

  for dir in "$WORKSHOP"/*/; do
    [[ -d "$dir" ]] || continue
    id=$(basename "$dir")
    printf '%s\t%s\n' "$id" "$(wallpaper_title "$dir")"
  done | sort -t $'\t' -k2,2 >"$tmp"

  [[ -s "$tmp" ]] || die "no workshop wallpapers in $WORKSHOP"

  if command -v gum >/dev/null 2>&1 && [[ -t 0 ]]; then
    choice=$(gum filter --height=20 --placeholder="Wallpaper Engine workshop..." <"$tmp") || exit 1
  else
    choice=$(fzf --height=40% --reverse --delimiter=$'\t' --with-nth=2,1 <"$tmp") || exit 1
  fi

  id=${choice%%$'\t'*}
  [[ -n "$id" ]] || exit 1
  cmd_on "$id"
}

cmd_status() {
  if is_running; then
    local id=""
    [[ -f "$STATE_FILE" ]] && id=$(cat "$STATE_FILE")
    echo "running${id:+: $id}"
    [[ -f "$PID_FILE" ]] && echo "pid=$(cat "$PID_FILE")"
  else
    echo "stopped"
  fi
  echo "workshop=$WORKSHOP ($(find "$WORKSHOP" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l) items)"
  echo "screen=$(default_screen)"
  echo "engine=$(command -v "$ENGINE" 2>/dev/null || echo missing)"
}

cmd_toggle() {
  if is_running; then
    cmd_off
  else
    cmd_on "$@"
  fi
}

usage() {
  cat <<'EOF'
Usage: we-wallpaper <command> [id]

Commands:
  select          Pick a Steam Workshop wallpaper (gum/fzf) and run it
  on [id|path]    Start Wallpaper Engine (last id if omitted)
  off             Stop and restore Omarchy background
  toggle [id]     Stop if running, otherwise start
  status          Show engine / paths

Env:
  WE_SCREEN   Hyprland output name (default: focused monitor)
  WE_FPS      Cap FPS (default: 30)
  WE_WORKSHOP Override workshop dir
  WE_ASSETS   Override Wallpaper Engine assets dir
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    select|pick) cmd_select "$@" ;;
    on|start) cmd_on "$@" ;;
    off|stop) cmd_off "$@" ;;
    toggle) cmd_toggle "$@" ;;
    status) cmd_status "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $cmd (try --help)" ;;
  esac
}

main "$@"
