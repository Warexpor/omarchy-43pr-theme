#!/usr/bin/env python3
"""Long-lived Discord IPC session for mute/deafen/camera hotkeys.

Listens on $XDG_RUNTIME_DIR/discord-voice.sock for one-line commands:
  mute | deafen | video | ping | quit

Kept authenticated; auto-refreshes OAuth tokens and reconnects on Discord restart.
"""

from __future__ import annotations

import json
import os
import signal
import socket
import struct
import sys
import threading
import time
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "discord-voice"
CONFIG_PATH = CONFIG_DIR / "config.json"
TOKEN_PATH = CONFIG_DIR / "token.json"
REDIRECT_URI = "http://127.0.0.1/callback"
LOG_PATH = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "discord-voice-daemon.log"

_URL_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def log(msg: str) -> None:
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n"
    try:
        LOG_PATH.open("a").write(line)
    except Exception:
        pass
    print(line, end="", flush=True)


def notify(title: str, body: str = "") -> None:
    try:
        import subprocess

        subprocess.run(
            ["notify-send", "-a", "discord-voice", "-t", "1600", title, body],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def load_json(path: Path) -> dict:
    if not path.exists():
        return {}
    return json.loads(path.read_text())


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    os.chmod(path, 0o600)


def find_ipc() -> str:
    bases = []
    if os.environ.get("XDG_RUNTIME_DIR"):
        bases.append(os.environ["XDG_RUNTIME_DIR"])
    bases.append(f"/run/user/{os.getuid()}")
    for base in bases:
        for i in range(10):
            path = os.path.join(base, f"discord-ipc-{i}")
            if os.path.exists(path):
                return path
    raise FileNotFoundError("discord ipc missing")


def sock_path() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    return os.path.join(runtime, "discord-voice.sock")


def refresh_tokens(client_id: str, client_secret: str, refresh_token: str) -> dict:
    data = urllib.parse.urlencode(
        {
            "client_id": client_id,
            "client_secret": client_secret,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        }
    ).encode()
    req = urllib.request.Request(
        "https://discord.com/api/oauth2/token",
        data=data,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    with _URL_OPENER.open(req, timeout=20) as resp:
        return json.loads(resp.read().decode())


def ensure_access_token() -> tuple[str, str]:
    cfg = load_json(CONFIG_PATH)
    tok = load_json(TOKEN_PATH)
    client_id = (cfg.get("client_id") or "").strip()
    client_secret = (cfg.get("client_secret") or "").strip()
    if not client_id or not client_secret:
        raise RuntimeError(f"missing credentials in {CONFIG_PATH}")
    access = tok.get("access_token")
    refresh = tok.get("refresh_token")
    expires_at = float(tok.get("expires_at") or 0)
    if access and time.time() < expires_at - 120:
        return client_id, access
    if not refresh:
        raise RuntimeError("no refresh token — run: discord-voice auth")
    fresh = refresh_tokens(client_id, client_secret, refresh)
    save_json(
        TOKEN_PATH,
        {
            "access_token": fresh["access_token"],
            "refresh_token": fresh.get("refresh_token", refresh),
            "expires_at": time.time() + int(fresh.get("expires_in", 604800)),
            "scope": fresh.get("scope"),
        },
    )
    log("refreshed oauth token")
    return client_id, fresh["access_token"]


class Session:
    def __init__(self) -> None:
        self.sock: socket.socket | None = None
        self.lock = threading.RLock()
        self.client_id = ""

    def close(self) -> None:
        if self.sock:
            try:
                self.sock.close()
            except Exception:
                pass
            self.sock = None

    def _send(self, op: int, payload: dict) -> None:
        assert self.sock is not None
        data = json.dumps(payload).encode()
        self.sock.sendall(struct.pack("<II", op, len(data)) + data)

    def _recv(self) -> dict:
        assert self.sock is not None
        header = self.sock.recv(8)
        if len(header) < 8:
            raise ConnectionError("ipc closed")
        _op, length = struct.unpack("<II", header)
        body = b""
        while len(body) < length:
            chunk = self.sock.recv(length - len(body))
            if not chunk:
                raise ConnectionError("ipc closed")
            body += chunk
        return json.loads(body.decode())

    def _recv_nonce(self, nonce: str, timeout: float = 10.0) -> dict:
        assert self.sock is not None
        deadline = time.time() + timeout
        while time.time() < deadline:
            self.sock.settimeout(max(0.2, deadline - time.time()))
            msg = self._recv()
            if msg.get("nonce") == nonce:
                return msg
        raise TimeoutError(f"no reply for nonce {nonce}")

    def connect(self) -> None:
        with self.lock:
            self.close()
            client_id, access = ensure_access_token()
            self.client_id = client_id
            path = find_ipc()
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(10.0)
            s.connect(path)
            self.sock = s
            self._send(0, {"v": 1, "client_id": client_id})
            ready = self._recv()
            if ready.get("evt") != "READY":
                raise RuntimeError(f"bad handshake: {ready}")
            nonce = str(uuid.uuid4())
            self._send(1, {"cmd": "AUTHENTICATE", "nonce": nonce, "args": {"access_token": access}})
            auth = self._recv_nonce(nonce, timeout=8.0)
            if auth.get("evt") == "ERROR":
                # Token may be stale — refresh once and retry.
                if TOKEN_PATH.exists():
                    tok = load_json(TOKEN_PATH)
                    tok["expires_at"] = 0
                    save_json(TOKEN_PATH, tok)
                raise RuntimeError(f"AUTHENTICATE failed: {auth.get('data')}")
            log("authenticated IPC session")

    def ensure(self) -> None:
        with self.lock:
            if self.sock is None:
                self.connect()
                return
            # cheap liveness: GET_VOICE_SETTINGS
            try:
                nonce = str(uuid.uuid4())
                self._send(1, {"cmd": "GET_VOICE_SETTINGS", "nonce": nonce, "args": {}})
                msg = self._recv_nonce(nonce, timeout=3.0)
                if msg.get("evt") == "ERROR":
                    raise RuntimeError(str(msg.get("data")))
            except Exception as e:
                log(f"session dead ({e}); reconnecting")
                self.connect()

    def command(self, cmd: str, args: dict | None = None) -> dict:
        with self.lock:
            self.ensure()
            nonce = str(uuid.uuid4())
            self._send(1, {"cmd": cmd, "nonce": nonce, "args": args or {}})
            return self._recv_nonce(nonce, timeout=5.0)


SESSION = Session()
_LAST = {"cmd": "", "at": 0.0}
_DEBOUNCE_S = 0.35


def handle_mute() -> str:
    cur = SESSION.command("GET_VOICE_SETTINGS")
    if cur.get("evt") == "ERROR":
        raise RuntimeError(str(cur.get("data")))
    data = cur.get("data") or {}
    new_mute = not bool(data.get("mute"))
    args = {"mute": new_mute}
    if data.get("deaf") is not None:
        args["deaf"] = bool(data.get("deaf"))
    res = SESSION.command("SET_VOICE_SETTINGS", args)
    if res.get("evt") == "ERROR":
        raise RuntimeError(str(res.get("data")))
    notify("Mic muted" if new_mute else "Mic unmuted")
    return f"mute={new_mute}"


def handle_deafen() -> str:
    cur = SESSION.command("GET_VOICE_SETTINGS")
    if cur.get("evt") == "ERROR":
        raise RuntimeError(str(cur.get("data")))
    data = cur.get("data") or {}
    new_deaf = not bool(data.get("deaf"))
    # Match Discord UI: deafen forces mute; undeafen clears both.
    res = SESSION.command(
        "SET_VOICE_SETTINGS",
        {"deaf": new_deaf, "mute": new_deaf},
    )
    if res.get("evt") == "ERROR":
        raise RuntimeError(str(res.get("data")))
    notify("Deafened" if new_deaf else "Undeafened")
    return f"deaf={new_deaf}"


def handle_video() -> str:
    res = SESSION.command("TOGGLE_VIDEO", {})
    if res.get("evt") == "ERROR":
        raise RuntimeError(str(res.get("data")))
    notify("Camera toggled")
    return "video=toggled"


HANDLERS = {
    "mute": handle_mute,
    "deafen": handle_deafen,
    "video": handle_video,
}


def handle_line(line: str) -> str:
    cmd = line.strip().lower()
    if cmd in {"", "ping"}:
        SESSION.ensure()
        return "pong"
    if cmd == "quit":
        return "bye"
    if cmd not in HANDLERS:
        return f"error unknown:{cmd}"
    now = time.time()
    if cmd == _LAST["cmd"] and (now - _LAST["at"]) < _DEBOUNCE_S:
        return f"debounce {cmd}"
    _LAST["cmd"] = cmd
    _LAST["at"] = now
    for attempt in range(1, 4):
        try:
            return HANDLERS[cmd]()
        except Exception as e:
            log(f"{cmd} attempt {attempt} failed: {e}")
            SESSION.close()
            time.sleep(0.2 * attempt)
    return f"error {cmd} failed"


def serve() -> None:
    path = sock_path()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass

    # Authenticate before exposing the socket so clients do not hang on accept.
    while True:
        try:
            SESSION.connect()
            break
        except Exception as e:
            log(f"waiting for Discord: {type(e).__name__}: {e}")
            time.sleep(2.0)

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    os.chmod(path, 0o600)
    server.listen(8)
    log(f"listening on {path}")

    stop = False

    def _stop(*_a: object) -> None:
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    server.settimeout(1.0)
    while not stop:
        try:
            conn, _ = server.accept()
        except socket.timeout:
            continue
        except Exception as e:
            if stop:
                break
            log(f"accept error: {e}")
            continue
        with conn:
            conn.settimeout(5.0)
            try:
                data = b""
                while not data.endswith(b"\n") and len(data) < 64:
                    chunk = conn.recv(64)
                    if not chunk:
                        break
                    data += chunk
                line = data.decode(errors="replace")
                result = handle_line(line)
                conn.sendall((result + "\n").encode())
                if result == "bye":
                    stop = True
            except Exception as e:
                log(f"client error: {e}")
                try:
                    conn.sendall(f"error {e}\n".encode())
                except Exception:
                    pass

    SESSION.close()
    server.close()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    log("daemon stopped")


if __name__ == "__main__":
    serve()
