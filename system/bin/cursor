#!/usr/bin/env bash
# Cursor: launch the app, or manage upstream stable-channel updates.
#   cursor                 → launch
#   cursor status|upgrade  → upstream package check/install
# Tracks releaseTrack=stable (AUR cursor-bin feed).
set -euo pipefail

PKG=cursor-bin
CONFLICT_PKG=cursor-nightly-bin
UPSTREAM_TRACKS=(stable)
DOWNLOAD_API='https://cursor.com/api/download?platform=linux-x64&releaseTrack=%s'
PKG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/cursor-upstream/pkg"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cursor"
STATE_FILE="${STATE_DIR}/last-notified"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/cursor-update.lock"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cursor-upstream"
# Packaged launcher (flags + agent/editor); shadowed by this script via /usr/local/bin.
APP_LAUNCHER=/usr/bin/cursor

usage() {
  cat <<'EOF'
Usage: cursor [<command> | app args...]

  (no command / other args)  Launch Cursor

  status   Show installed vs upstream versions
  check    Exit 0 if an upstream update (or first install) is available
  upgrade  Check now; install if available, otherwise say you're up to date
  notify   If an update is available, send a clickable Omarchy toast
  apply    Build/install from upstream (run from the toast click)
  help     Show this help
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

launch_app() {
  if [[ -x $APP_LAUNCHER ]]; then
    exec "$APP_LAUNCHER" "$@"
  fi
  local bin=/usr/share/cursor/bin/cursor
  [[ -x $bin ]] || {
    echo "Cursor is not installed. Run: cursor upgrade" >&2
    exit 1
  }
  exec "$bin" "$@"
}

installed_version() {
  pacman -Q "$PKG" 2>/dev/null | awk '{print $2}' \
    || pacman -Q "$CONFLICT_PKG" 2>/dev/null | awk '{print $2}' \
    || true
}

installed_base() {
  local v
  v=$(installed_version)
  [[ -n $v ]] || return 0
  printf '%s\n' "${v%-*}"
}

has_conflict_pkg() {
  pkg_installed_exact "$CONFLICT_PKG" && ! pacman -Q "$PKG" &>/dev/null
}

has_target_pkg() {
  pacman -Q "$PKG" &>/dev/null
}

# Prints: version|commit|track|deb_url
fetch_upstream() {
  need curl
  need jq

  local track code body version commit deb_url constructed
  for track in "${UPSTREAM_TRACKS[@]}"; do
    code=$(curl -sS -o "$CACHE_DIR/meta.json" -w '%{http_code}' --max-time 20 \
      -H 'Accept: application/json' -H 'cache-control: no-cache' \
      "$(printf "$DOWNLOAD_API" "$track")" || echo err)
    [[ $code == 200 ]] || continue

    body=$(<"$CACHE_DIR/meta.json")
    version=$(jq -r '.version // empty' <<<"$body")
    commit=$(jq -r '.commitSha // .commitHash // empty' <<<"$body")
    [[ -n $version && -n $commit ]] || continue

    deb_url=$(jq -r '.debUrl // empty' <<<"$body")
    if [[ -z $deb_url ]]; then
      constructed="https://downloads.cursor.com/production/${commit}/linux/x64/deb/amd64/deb/cursor_${version}_amd64.deb"
      if curl -fsSI --max-time 15 "$constructed" >/dev/null 2>&1; then
        deb_url=$constructed
      else
        continue
      fi
    fi

    printf '%s|%s|%s|%s\n' "$version" "$commit" "$track" "$deb_url"
    return 0
  done

  echo "Could not fetch Cursor upstream metadata (tried: ${UPSTREAM_TRACKS[*]})" >&2
  return 1
}

update_available() {
  local meta version installed
  meta=$(fetch_upstream) || return 2
  version=${meta%%|*}

  if ! has_target_pkg; then
    printf '%s\n' "$version"
    return 0
  fi

  installed=$(installed_base)
  if (( $(vercmp "$version" "$installed") > 0 )); then
    printf '%s\n' "$version"
    return 0
  fi
  return 1
}

cmd_status() {
  local installed meta version commit track deb_url
  installed=$(installed_version)

  echo "Package:   $PKG"
  echo "Installed: ${installed:-not installed}"

  if meta=$(fetch_upstream); then
    IFS='|' read -r version commit track deb_url <<<"$meta"
    echo "Upstream:  $version ($track feed, commit ${commit:0:12})"
  else
    echo "Upstream:  unavailable"
    version=
  fi

  if has_conflict_pkg; then
    echo "Conflict:  $CONFLICT_PKG is installed (will be replaced on apply)"
  fi

  if [[ -n ${version:-} ]] && available=$(update_available); then
    echo "Status:    update available → $available"
  else
    echo "Status:    up to date with upstream"
  fi
}

cmd_check() {
  update_available >/dev/null
}

run_pacman() {
  if [[ -t 0 || -t 1 ]] && command -v sudo >/dev/null; then
    sudo pacman "$@"
  elif command -v pkexec >/dev/null; then
    pkexec pacman "$@"
  else
    echo "Need sudo or pkexec to run: pacman $*" >&2
    exit 1
  fi
}

# True only if a package with this exact name is installed (not merely provided).
pkg_installed_exact() {
  local name=$1
  [[ $(pacman -Qq "$name" 2>/dev/null) == "$name" ]]
}

# --noconfirm answers N to "Remove conflicting package?" — remove it first.
remove_conflict_pkgs() {
  local p
  for p in "$CONFLICT_PKG" cursor-early-access-bin cursor-ide-bin; do
    if pkg_installed_exact "$p"; then
      echo "Removing conflicting package $p…"
      run_pacman -Rdd --noconfirm "$p"
    fi
  done
}

pacman_install() {
  local pkg=$1
  remove_conflict_pkgs
  run_pacman -U --noconfirm "$pkg"
}

write_pkgbuild() {
  local version=$1 commit=$2 deb_hash=$3
  local desktop_hash launcher_hash
  desktop_hash=$(sha256sum "$PKG_DIR/cursor.desktop" | awk '{print $1}')
  launcher_hash=$(sha256sum "$PKG_DIR/cursor-launcher.sh" | awk '{print $1}')

  cat >"$PKG_DIR/PKGBUILD" <<EOF
# Local upstream build — managed by ~/.local/bin/cursor
pkgname=cursor-bin
pkgver=${version}
_upstream_pkgver=${version}
pkgrel=1
pkgdesc='AI-first coding environment (upstream stable channel, bundled Electron)'
arch=('x86_64')
url='https://www.cursor.com'
license=('LicenseRef-Cursor_EULA')
provides=('cursor')
conflicts=('cursor-nightly-bin' 'cursor-early-access-bin' 'cursor-ide-bin')
replaces=('cursor-nightly-bin' 'cursor-early-access-bin' 'cursor-ide-bin')
depends=(
  alsa-lib
  dbus
  gcc-libs
  gtk3
  libdrm
  libsecret
  libxkbfile
  mesa
  nss
  xdg-utils
)
optdepends=(
  'libnotify: desktop notifications'
  'org.freedesktop.secrets: credential storage via SecretService'
  'libdbusmenu-glib: KDE global menu support'
)
options=('!strip' '!debug')
_commit=${commit}
source=(
  "cursor_\${_upstream_pkgver}_amd64.deb::https://downloads.cursor.com/production/\${_commit}/linux/x64/deb/amd64/deb/cursor_\${_upstream_pkgver}_amd64.deb"
  cursor.desktop
  cursor-launcher.sh
)
sha256sums=(
  '${deb_hash}'
  '${desktop_hash}'
  '${launcher_hash}'
)
noextract=("cursor_\${_upstream_pkgver}_amd64.deb")

package() {
  bsdtar -xOf "cursor_\${_upstream_pkgver}_amd64.deb" data.tar.xz |
    tar -xJf - -C "\$pkgdir"

  if [[ -d "\$pkgdir/usr/share/zsh/vendor-completions" ]]; then
    mv "\$pkgdir/usr/share/zsh/vendor-completions" \\
      "\$pkgdir/usr/share/zsh/site-functions"
  fi

  install -Dm644 "\$srcdir/cursor.desktop" \\
    "\$pkgdir/usr/share/applications/cursor.desktop"

  install -Dm755 "\$srcdir/cursor-launcher.sh" "\$pkgdir/usr/bin/cursor"

  _license="\$pkgdir/usr/share/cursor/resources/app/LICENSE.txt"
  if [[ ! -f "\$_license" ]]; then
    _license=\$(find "\$pkgdir/usr/share/cursor" -maxdepth 8 -type f \\( -name 'LICENSE.txt' -o -name 'LICENSE' \\) -print -quit 2>/dev/null || true)
  fi
  if [[ -f "\$_license" ]]; then
    install -Dm644 "\$_license" "\$pkgdir/usr/share/licenses/\$pkgname/LICENSE"
  fi

  if [[ -f "\$pkgdir/usr/share/cursor/chrome-sandbox" ]]; then
    chmod 4755 "\$pkgdir/usr/share/cursor/chrome-sandbox"
  fi
}
EOF
}

cmd_apply() {
  need curl
  need jq
  need makepkg
  need bsdtar

  [[ -d $PKG_DIR ]] || {
    echo "Missing package dir: $PKG_DIR" >&2
    exit 1
  }

  mkdir -p "$CACHE_DIR" "$STATE_DIR"

  local meta version commit track deb_url deb_file deb_hash out_pkg installed
  meta=$(fetch_upstream)
  IFS='|' read -r version commit track deb_url <<<"$meta"

  echo "Updating Cursor from upstream ($track) → $version…"
  echo "Commit: $commit"
  echo

  deb_file="$PKG_DIR/cursor_${version}_amd64.deb"
  echo "Downloading .deb…"
  curl -fL --max-time 600 -o "$deb_file" "$deb_url"
  deb_hash=$(sha256sum "$deb_file" | awk '{print $1}')
  write_pkgbuild "$version" "$commit" "$deb_hash"

  # Drop stale package artifacts so makepkg rebuilds cleanly.
  rm -f "$PKG_DIR"/cursor-bin-*.pkg.tar.zst "$PKG_DIR"/cursor-nightly-bin-*.pkg.tar.zst
  rm -rf "$PKG_DIR"/pkg "$PKG_DIR"/src

  (
    cd "$PKG_DIR"
    makepkg -f --noconfirm
  )

  out_pkg=$(ls -1t "$PKG_DIR"/cursor-bin-*.pkg.tar.zst | head -1)
  [[ -n $out_pkg ]] || {
    echo "makepkg did not produce a package" >&2
    exit 1
  }

  if has_conflict_pkg; then
    echo "Replacing $CONFLICT_PKG with $PKG (conflict)."
  fi

  pacman_install "$out_pkg"

  installed=$(pacman -Q "$PKG" 2>/dev/null | awk '{print $2}' || true)
  if [[ -z $installed ]]; then
    echo "Install did not register $PKG." >&2
    exit 1
  fi

  printf '%s\n' "$installed" >"$STATE_FILE"

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send \
      --app-name Cursor \
      -u low \
      -g $'\uf00c' \
      "Cursor Ready" \
      "Installed $installed — restart Cursor to use it."
  fi

  echo
  echo "Installed $PKG $installed (upstream $track)"
  echo "Restart Cursor to pick up the new build."
}

cmd_upgrade() {
  local available installed
  if ! available=$(update_available); then
    installed=$(installed_version)
    if [[ -n $installed ]]; then
      echo "Cursor is up to date with upstream ($installed)."
    else
      echo "Cursor is up to date with upstream."
    fi
    return 0
  fi

  installed=$(installed_version)
  if ! has_target_pkg; then
    echo "Update available: install $available"
  else
    echo "Update available: $installed → $available"
  fi
  echo
  cmd_apply
}

cmd_notify() {
  need jq
  need curl
  need omarchy-notification-send

  local available installed body headline
  if ! available=$(update_available); then
    exit 1
  fi

  mkdir -p "$STATE_DIR"
  if [[ -f $STATE_FILE ]] && [[ $(<"$STATE_FILE") == "$available" ]]; then
    exit 0
  fi

  omarchy-notification-wait 15 || true

  installed=$(installed_version)
  if [[ -z $installed ]]; then
    headline="Cursor Update Available"
    if has_conflict_pkg; then
      body="Click to switch from $CONFLICT_PKG to upstream $available"
    else
      body="Click to install upstream Cursor $available"
    fi
  else
    headline="Cursor Update"
    body="Click to update $installed → $available (upstream)"
  fi

  omarchy-notification-send \
    --app-name Cursor \
    -u normal \
    -g $'\uf019' \
    -t 0 \
    "$headline" \
    "$body" \
    --exec omarchy-launch-floating-terminal-with-presentation cursor apply

  printf '%s\n' "$available" >"$STATE_FILE"
}

main() {
  mkdir -p "$CACHE_DIR"

  # Migrate state from the old cursor-nightly path once.
  local old_state="${XDG_STATE_HOME:-$HOME/.local/state}/cursor-nightly"
  if [[ ! -d $STATE_DIR && -d $old_state ]]; then
    mkdir -p "$(dirname "$STATE_DIR")"
    mv "$old_state" "$STATE_DIR"
  fi

  local cmd=${1:-}
  case $cmd in
  status)
    shift
    cmd_status "$@"
    ;;
  check)
    shift
    cmd_check "$@"
    ;;
  upgrade | update)
    shift
    cmd_upgrade "$@"
    ;;
  notify)
    shift
    exec 9>"$LOCK_FILE"
    flock -n 9 || exit 0
    cmd_notify "$@"
    ;;
  apply)
    shift
    cmd_apply "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    # No subcommand (or app args) → launch
    launch_app "$@"
    ;;
  esac
}

main "$@"
