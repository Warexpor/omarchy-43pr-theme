#!/bin/bash
# Crop the current wallpaper to the bar strip (same geometry as omarchy-bar-text-color).
set -euo pipefail

position=${1:-top}
bar_size=${2:-24}
out=${3:-}
screen_size=${4:-}

[[ -n $out ]] || exit 1
[[ $position =~ ^(top|bottom|left|right)$ ]] || exit 1
[[ $bar_size =~ ^[0-9]+$ ]] || exit 1

background_path=$(readlink -f "${HOME}/.local/state/omarchy/current/background" 2>/dev/null || true)
[[ -f $background_path ]] || exit 1

if [[ -z $screen_size ]]; then
  screen_size=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0] | "\(.width)x\(.height)"' 2>/dev/null || true)
fi
[[ $screen_size =~ ^([0-9]+)x([0-9]+)$ ]] || exit 1
screen_width=${BASH_REMATCH[1]}
screen_height=${BASH_REMATCH[2]}

case "$position" in
top) crop="${screen_width}x${bar_size}+0+0" ;;
bottom)
  crop_y=$((screen_height - bar_size))
  crop="${screen_width}x${bar_size}+0+${crop_y}"
  ;;
left) crop="${bar_size}x${screen_height}+0+0" ;;
right)
  crop_x=$((screen_width - bar_size))
  crop="${bar_size}x${screen_height}+${crop_x}+0"
  ;;
esac

mkdir -p "$(dirname "$out")"
tmp="${out}.tmp.$$"
magick "$background_path" -auto-orient \
  -resize "${screen_width}x${screen_height}^" \
  -gravity center -extent "${screen_width}x${screen_height}" \
  -gravity NorthWest -crop "$crop" +repage \
  "$tmp"
mv -f "$tmp" "$out"
