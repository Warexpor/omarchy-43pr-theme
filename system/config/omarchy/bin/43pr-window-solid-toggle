#!/bin/bash

# Toggles transparency for the focused window; Foot gets a real solid mode.
#
# 43PR: bound to SUPER + BACKSPACE by absolute path from bindings.lua (Hyprland
# puts /usr/share/omarchy/bin first on PATH, so a same-name shadow never runs).
# Foot paints its own glass (alpha + ext-background-effect blur), so Hyprland's
# opaque prop can't make it solid. For Foot windows flip that one window between
# [colors-dark] (glass) and [colors-light] (solid) with SIGUSR1/SIGUSR2.
# Everything else falls through to the stock toggle.

STOCK=/usr/bin/omarchy-hyprland-window-transparency-toggle
win=$(hyprctl activewindow -j)
pid=$(jq -r '.pid // empty' <<<"$win")
addr=$(jq -r '.address // empty' <<<"$win")

if [[ -z $pid || $(cat "/proc/$pid/comm" 2>/dev/null) != foot ]]; then
  exec "$STOCK"
fi

# Foot can't report its current theme, so remember solid windows by pid plus
# process start time (guards against pid reuse after the window closes).
state_dir="${XDG_RUNTIME_DIR:-/tmp}/43pr-foot-solid"
mkdir -p "$state_dir"
started=$(awk '{print $22}' "/proc/$pid/stat")
mark="$state_dir/$pid"

for f in "$state_dir"/*; do
  [[ -e $f ]] || continue
  [[ -d /proc/$(basename "$f") ]] || rm -f "$f"
done

# Pin Hyprland's opaque prop with the theme so window opacity rules (stock
# default-opacity) can't let the wallpaper bleed through the solid mode.
set_opaque() {
  hyprctl dispatch "hl.dsp.window.set_prop({ window = \"address:$addr\", prop = \"opaque\", value = \"$1\" })" >/dev/null 2>&1
}

if [[ -f $mark && $(<"$mark") == "$started" ]]; then
  kill -USR1 "$pid" && rm -f "$mark" && set_opaque false
else
  kill -USR2 "$pid" && echo "$started" >"$mark" && set_opaque true
fi
