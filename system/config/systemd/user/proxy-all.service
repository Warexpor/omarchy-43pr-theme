[Unit]
Description=Standalone xray: SOCKS5 :10808 + transparent :10809
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=XRAY_LOCATION_ASSET={{HOME}}/.local/share/v2rayN/bin
ExecStart={{HOME}}/.local/share/v2rayN/bin/xray/xray run -c {{HOME}}/.local/share/proxy-all/xray-config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
