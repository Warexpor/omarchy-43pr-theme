#!/bin/bash
# Pick a light-ink or dark-ink monochrome btop theme from wallpaper luminance,
# then SIGUSR2 running btop instances so they reload.
# (TUI can't do per-pixel ink; this is whole-theme adaptive contrast.)

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy"
MODE_FILE="$CACHE_DIR/btop-adaptive-ink.mode"
OUT_THEME="$STATE_DIR/current/theme/btop.theme"
THEME_OVERLAY="$HOME/.config/omarchy/themes/43pr/btop.theme"
REPO_THEME="/home/warexpor/Work/MyProjects/omarchy-43pr-theme/btop.theme"

mkdir -p "$CACHE_DIR" "$(dirname "$OUT_THEME")"

background=$(readlink -f "$STATE_DIR/current/background" 2>/dev/null || true)
[[ -f $background ]] || exit 0

command -v magick >/dev/null 2>&1 || exit 0

# Average the whole wallpaper (btop usually covers most of the screen).
pixel=$(magick "$background" -auto-orient -resize '1x1!' \
  -format '%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]' info:- 2>/dev/null || true)
[[ $pixel =~ ^([0-9]+),([0-9]+),([0-9]+)$ ]] || exit 0

r=${BASH_REMATCH[1]}
g=${BASH_REMATCH[2]}
b=${BASH_REMATCH[3]}

# Relative luminance (sRGB-ish, same weights as the bar shader).
lum=$(awk -v r="$r" -v g="$g" -v b="$b" 'BEGIN {
  R=r/255; G=g/255; B=b/255
  printf "%.6f\n", 0.2126*R + 0.7152*G + 0.0722*B
}')

threshold=${BTOP_ADAPTIVE_THRESHOLD:-0.55}
mode=light-ink
awk -v lum="$lum" -v thr="$threshold" 'BEGIN { exit !(lum > thr) }' && mode=dark-ink

prev=$(cat "$MODE_FILE" 2>/dev/null || true)
force=0
[[ ${1:-} == --force ]] && force=1
if (( force == 0 )) && [[ $prev == "$mode" ]] && [[ -f $OUT_THEME ]]; then
  exit 0
fi

