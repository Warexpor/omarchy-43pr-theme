tmp=$(mktemp)
if [[ $mode == dark-ink ]]; then
  write_dark_ink >"$tmp"
else
  write_light_ink >"$tmp"
fi

install -m 644 "$tmp" "$OUT_THEME"
# Keep the user theme overlay in sync so the next theme-set starts from this.
mkdir -p "$(dirname "$THEME_OVERLAY")"
install -m 644 "$tmp" "$THEME_OVERLAY"
if [[ -d $(dirname "$REPO_THEME") ]]; then
  install -m 644 "$tmp" "$REPO_THEME" 2>/dev/null || true
fi
rm -f "$tmp"

printf '%s\n' "$mode" >"$MODE_FILE"

# Reload live btop (Omarchy uses SIGUSR2 for theme/config refresh).
# -x: exact name — otherwise this script's own argv matches "btop".
pkill -x -SIGUSR2 btop 2>/dev/null || true

echo "btop-adaptive-ink: lum=$lum mode=$mode"
