{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "transparent",
    "panel": "transparent",
    "element": "transparent",
    "menu": "#121212aa",
    "line": "#2a2a2acc",
    "lineSoft": "#1e1e1e99",
    "muted": "#6e6e6e",
    "text": "#c8c8c8",
    "bright": "#ececec",
    "silver": "#aaaaaa",
    "dim": "#4a4a4a",
    "ok": "#b8b8b8",
    "warn": "#d0d0d0",
    "err": "#f0f0f0",
    "diffAddBg": "transparent",
    "diffDelBg": "transparent"
  },
  "theme": {
    "primary": { "dark": "silver", "light": "dim" },
    "secondary": { "dark": "text", "light": "muted" },
    "accent": { "dark": "bright", "light": "dim" },
    "error": { "dark": "err", "light": "err" },
    "warning": { "dark": "warn", "light": "warn" },
    "success": { "dark": "ok", "light": "ok" },
    "info": { "dark": "silver", "light": "silver" },

    "text": { "dark": "text", "light": "#1a1a1a" },
    "textMuted": { "dark": "muted", "light": "#6e6e6e" },
    "selectedListItemText": { "dark": "#0a0a0a", "light": "#ffffff" },

    "background": { "dark": "bg", "light": "transparent" },
    "backgroundPanel": { "dark": "panel", "light": "transparent" },
    "backgroundElement": { "dark": "element", "light": "transparent" },
    "backgroundMenu": { "dark": "menu", "light": "#efefefaa" },

    "border": { "dark": "line", "light": "#d0d0d0" },
    "borderActive": { "dark": "silver", "light": "#888888" },
    "borderSubtle": { "dark": "lineSoft", "light": "#e0e0e0" },

    "diffAdded": { "dark": "ok", "light": "ok" },
    "diffRemoved": { "dark": "err", "light": "err" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "silver", "light": "silver" },
    "diffHighlightAdded": { "dark": "bright", "light": "dim" },
    "diffHighlightRemoved": { "dark": "err", "light": "err" },
    "diffAddedBg": { "dark": "diffAddBg", "light": "transparent" },
    "diffRemovedBg": { "dark": "diffDelBg", "light": "transparent" },
    "diffContextBg": { "dark": "panel", "light": "transparent" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "diffAddBg", "light": "transparent" },
    "diffRemovedLineNumberBg": { "dark": "diffDelBg", "light": "transparent" },

    "markdownText": { "dark": "text", "light": "#1a1a1a" },
    "markdownHeading": { "dark": "bright", "light": "#111111" },
    "markdownLink": { "dark": "silver", "light": "dim" },
    "markdownLinkText": { "dark": "text", "light": "#333333" },
    "markdownCode": { "dark": "silver", "light": "dim" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "text", "light": "#333333" },
    "markdownStrong": { "dark": "bright", "light": "#111111" },
    "markdownHorizontalRule": { "dark": "line", "light": "#d0d0d0" },
    "markdownListItem": { "dark": "text", "light": "#1a1a1a" },
    "markdownListEnumeration": { "dark": "silver", "light": "dim" },
    "markdownImage": { "dark": "silver", "light": "dim" },
    "markdownImageText": { "dark": "muted", "light": "muted" },
    "markdownCodeBlock": { "dark": "text", "light": "#1a1a1a" },

    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "bright", "light": "#222222" },
    "syntaxFunction": { "dark": "silver", "light": "dim" },
    "syntaxVariable": { "dark": "text", "light": "#1a1a1a" },
    "syntaxString": { "dark": "ok", "light": "#444444" },
    "syntaxNumber": { "dark": "warn", "light": "#555555" },
    "syntaxType": { "dark": "silver", "light": "dim" },
    "syntaxOperator": { "dark": "muted", "light": "muted" },
    "syntaxPunctuation": { "dark": "text", "light": "#1a1a1a" }
  }
}
